import MinimalModel.Statements.Basic

/-!
# Linear systems, very general members and the sets of boundaries of BCHM

This file gives the vocabulary of the general ample divisors of BCHM (arXiv:math/0610203), the paragraph after Definition 1.1.4. There `A` is general when `k A` is very ample over `U` and `A = A' / k` for a very general `A'` in the linear system of `k A`.

* `RRSpace D` is `H⁰(X, 𝒪_X(D))`: the rational functions `φ` with `φ = 0` or `D + div φ ≥ 0`. It is a submodule, because `ord_P (φ + ψ) ≥ min (ord_P φ, ord_P ψ)` at each prime divisor, and the stalks there are discrete valuation rings.
* `IsLinSysMember D φ E` says that `E = D + div φ` is the member of `|D|` given by `φ`.
* `IsVeryGeneral k S` says that the set `S` of a `k`-module contains the complement of countably many hypersurfaces. A hypersurface is the zero set of a nonzero polynomial function, and the polynomial functions are generated by the linear forms.
* `IsVeryAmpleOver D π` says that `D` is very ample over the base, on each affine open set of the base.
* `IsRationalAffineSubspace V` and `Pair.InLA` give the affine subspaces of BCHM Definition 1.1.4, defined over the rationals, and the set `L_A(V)`.

Each definition has a body, and the file uses none of the escape hatches of spec 09.2.
-/

universe u

open AlgebraicGeometry CategoryTheory Order TopologicalSpace

namespace MinimalModel

variable {k : Type u} [Field k] {X : NormalVariety k}

/-! ## The order of vanishing -/

/-- The stalk of a normal variety at a prime divisor is a discrete valuation ring. This is `isDiscreteValuationRing_stalk` of `MinimalModel/Fidelity/AffineLine.lean`. The statement files do not import the fidelity files, so the proof is here again. -/
theorem isDiscreteValuationRing_stalk_primeDivisor (P : PrimeDivisor X) :
    IsDiscreteValuationRing (X.toScheme.presheaf.stalk P.1) := by
  have h1 : Ring.KrullDimLE 1 (X.toScheme.presheaf.stalk P.1) := krullDimLE_of_coheight_le P.2.le
  have hnf : ¬ IsField (X.toScheme.presheaf.stalk P.1) := by
    intro h
    have h2 := ringKrullDim_stalk_eq_coheight P.1
    rw [P.2, ringKrullDim_eq_zero_of_isField h] at h2
    exact absurd h2 (by decide)
  have hm : IsLocalRing.maximalIdeal (X.toScheme.presheaf.stalk P.1) ≠ ⊥ :=
    fun h => hnf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
  have huniq : ∃! I : Ideal (X.toScheme.presheaf.stalk P.1), I ≠ ⊥ ∧ I.IsPrime :=
    ⟨IsLocalRing.maximalIdeal _, ⟨hm, inferInstance⟩, fun I hI =>
      IsLocalRing.eq_maximalIdeal ((Ring.krullDimLE_one_iff_of_isPrime_bot.mp h1) I hI.1 hI.2)⟩
  have key := (IsDiscreteValuationRing.TFAE _ hnf).out 1 4
  exact key.mpr ⟨X.isNormal.isIntegrallyClosed_stalk P.1, huniq⟩

/-- The order of a sum is at least the smaller order: `ord_P (φ + ψ) ≥ min (ord_P φ, ord_P ψ)` when `φ + ψ ≠ 0`. -/
theorem min_ordAt_le_ordAt_add {φ ψ : FF X} (h : φ + ψ ≠ 0) (P : PrimeDivisor X) :
    min (ordAt φ P) (ordAt ψ P) ≤ ordAt (φ + ψ) P := by
  have := isDiscreteValuationRing_stalk_primeDivisor P
  exact Scheme.ord_add h

/-- A constant has order zero along each prime divisor. -/
theorem ordAt_algebraMap (c : k) (P : PrimeDivisor X) : ordAt (algebraMap k (FF X) c) P = 0 := by
  by_cases hc : c = 0
  · rw [hc, map_zero]
    simp [ordAt]
  haveI : Nonempty (⊤ : X.toScheme.Opens) := ⟨⟨genericPoint X.toScheme, trivial⟩⟩
  have hu : IsUnit (X.toΓ c) := (IsUnit.mk0 c hc).map X.toΓ
  exact Scheme.ord_of_isUnit (X := X.toScheme) (U := ⊤) hu (x := P.1) trivial

/-- A nonzero constant multiple has the same order: `ord_P (c φ) = ord_P φ`. -/
theorem ordAt_smul {c : k} (hc : c ≠ 0) {φ : FF X} (hφ : φ ≠ 0) (P : PrimeDivisor X) :
    ordAt (c • φ) P = ordAt φ P := by
  have hc' : algebraMap k (FF X) c ≠ 0 := (map_ne_zero _).mpr hc
  have h0 := ordAt_algebraMap c P
  unfold ordAt at h0 ⊢
  rw [Algebra.smul_def, Scheme.ord_mul hc' hφ, h0, zero_add]

/-! ## Linear systems -/

/-- The space `H⁰(X, 𝒪_X(D))`: the rational functions `φ` with `φ = 0` or `D + div φ ≥ 0`. It is a `k`-submodule of `k(X)`. Its nonzero elements give the members of the linear system `|D|` (`IsLinSysMember`). -/
noncomputable def RRSpace (D : Divisor ℤ X) : Submodule k (FF X) where
  carrier := {φ | φ = 0 ∨ ∀ P, 0 ≤ ordAt φ P + D P}
  zero_mem' := Or.inl rfl
  add_mem' := by
    intro φ ψ (hφ : φ = 0 ∨ ∀ P, 0 ≤ ordAt φ P + D P) (hψ : ψ = 0 ∨ ∀ P, 0 ≤ ordAt ψ P + D P)
    show φ + ψ = 0 ∨ ∀ P, 0 ≤ ordAt (φ + ψ) P + D P
    by_cases h : φ + ψ = 0
    · exact Or.inl h
    refine Or.inr fun P => ?_
    rcases hφ with rfl | hφ
    · rw [zero_add] at h ⊢
      exact hψ.resolve_left h P
    rcases hψ with rfl | hψ
    · rw [add_zero] at h ⊢
      exact hφ P
    have hm := min_ordAt_le_ordAt_add h P
    rcases le_total (ordAt φ P) (ordAt ψ P) with h' | h'
    · rw [min_eq_left h'] at hm
      linarith [hφ P]
    · rw [min_eq_right h'] at hm
      linarith [hψ P]
  smul_mem' := by
    intro c φ (hφ : φ = 0 ∨ ∀ P, 0 ≤ ordAt φ P + D P)
    show c • φ = 0 ∨ ∀ P, 0 ≤ ordAt (c • φ) P + D P
    by_cases hc : c = 0
    · exact Or.inl (by rw [hc, zero_smul])
    by_cases h0 : φ = 0
    · exact Or.inl (by rw [h0, smul_zero])
    refine Or.inr fun P => ?_
    rw [ordAt_smul hc h0 P]
    exact hφ.resolve_left h0 P

theorem mem_RRSpace_iff {D : Divisor ℤ X} {φ : FF X} :
    φ ∈ RRSpace D ↔ φ = 0 ∨ ∀ P, 0 ≤ ordAt φ P + D P := Iff.rfl

/-- `E` is the member `D + div φ` of the linear system `|D|` given by `φ`: `φ` is a nonzero element of `H⁰(X, 𝒪_X(D))`, and `E - D` is the divisor of `φ`. -/
def IsLinSysMember (D : Divisor ℤ X) (φ : FF X) (E : Divisor ℤ X) : Prop :=
  φ ∈ RRSpace D ∧ IsDivOn (E - D) φ Set.univ

/-! ## Very general points -/

variable (k) in
/-- The polynomial functions on a `k`-module `V`: the `k`-subalgebra of the functions `V → k` that the linear forms generate. -/
def polyFun (V : Type*) [AddCommGroup V] [Module k V] : Subalgebra k (V → k) :=
  Algebra.adjoin k (Set.range fun f : Module.Dual k V => ⇑f)

variable (k) in
/-- The set `S` of a `k`-module `V` contains each very general point: there are countably many nonzero polynomial functions on `V` such that each point where none of them vanishes is in `S`. Over a countable field the whole space is such a countable union of hypersurfaces, so the notion is useful only over an uncountable field. -/
def IsVeryGeneral {V : Type*} [AddCommGroup V] [Module k V] (S : Set V) : Prop :=
  ∃ F : Set (V → k), F.Countable ∧ (∀ f ∈ F, f ∈ polyFun k V ∧ f ≠ 0) ∧
    ∀ v : V, (∀ f ∈ F, f v ≠ 0) → v ∈ S

/-! ## Very ample divisors over a base -/

/-- The Cartier divisor `D` is very ample over `π : X → Z`. Over each affine open set `W` of `Z` there are sections `φ₀, ..., φ_N` of `D` on `π⁻¹ W`, with divisors `Eᵢ = D + div φᵢ ≥ 0` there, such that:
* the loci `Xᵢ` of `π⁻¹ W` where `Eᵢ` does not vanish cover `π⁻¹ W`;
* each `Xᵢ` is affine, and its ring of functions is generated by the functions of `W` and the quotients `φⱼ / φᵢ`.

These say that the sections give an immersion of `π⁻¹ W` in `ℙᴺ_W` with `𝒪(1)` pulling back to `𝒪(D)`: each `Xᵢ` is a closed subscheme of the chart `x_i ≠ 0`. It is a closed immersion when `π` is proper. The notion is local on `Z`, as `IsRelAmple` is. -/
def IsVeryAmpleOver {Z : Scheme.{u}} (D : Divisor ℤ X) (π : X.toScheme ⟶ Z) : Prop :=
  IsCartier D ∧ ∀ W : Z.Opens, IsAffineOpen W → ∀ hX : genericPoint X.toScheme ∈ π ⁻¹ᵁ W,
    ∃ (N : ℕ) (φ : Fin (N + 1) → FF X) (E : Fin (N + 1) → Divisor ℤ X),
      (∀ i, IsDivOn (E i - D) (φ i) (π ⁻¹ᵁ W) ∧ ∀ P : PrimeDivisor X, P.1 ∈ π ⁻¹ᵁ W → 0 ≤ E i P) ∧
      (∀ x ∈ π ⁻¹ᵁ W, ∃ i, x ∈ nonvanishing (E i) (π ⁻¹ᵁ W)) ∧
      ∀ i, ∃ V : X.toScheme.Opens, IsAffineOpen V ∧
        (V : Set X.toScheme) = nonvanishing (E i) (π ⁻¹ᵁ W) ∧
        ∀ hV : genericPoint X.toScheme ∈ V,
          (X.toScheme.presheaf.germ V _ hV).hom.range =
            Subring.closure (Set.range (fun s : Γ(Z, W) =>
              ((π.app W ≫ X.toScheme.presheaf.germ (π ⁻¹ᵁ W) _ hX).hom s : FF X)) ∪
              Set.range (fun j => φ j / φ i))

/-! ## The sets of boundaries of BCHM Definition 1.1.4 -/

/-- `V` is a finite dimensional affine subspace of the real Weil divisors that is defined over the rationals (BCHM 3.7.1): it is the affine span of finitely many divisors with rational coefficients. -/
def IsRationalAffineSubspace (V : AffineSubspace ℝ (Divisor ℝ X)) : Prop :=
  ∃ (N : ℕ) (B : Fin N → Divisor ℝ X), (∀ i, (B i).CoeffsIn (Set.range ((↑) : ℚ → ℝ))) ∧
    V = affineSpan ℝ (Set.range B)

/-- The boundary of the pair `(X, Δ)` is in `L_A(V)` (BCHM Definition 1.1.4): `Δ = A + B` with `B ∈ V` and `B ≥ 0`, and `K + Δ` is lc. -/
def Pair.InLA (P : Pair X) (A : Divisor ℝ X) (V : AffineSubspace ℝ (Divisor ℝ X)) : Prop :=
  IsLc P ∧ ∃ B ∈ V, 0 ≤ B ∧ P.Δ = A + B

end MinimalModel
